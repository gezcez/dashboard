# Copy to .env.development.local (or .env.<mode>.local) to override per machine.
VITE_ENV=development
# live: talk to VITE_API_URL. mock: MSW intercepts every request (no backend needed).
VITE_API_MODE=live
VITE_API_URL=http://localhost:3000
VITE_OAUTH_URL=http://localhost:5174
VITE_WS_URL=ws://localhost:3000/v1/ws
VITE_CLIENT_ID=dashboard-dev
VITE_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
VITE_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/positron
